# Supabase & Cloudinary Configuration for Class Attendance App

# 1. Supabase Settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 2. Render Backend API
EXPO_PUBLIC_API_BASE_URL=https://your-render-service.onrender.com

# 3. Cloudinary Settings (for Student Profile Photo Uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=attendance_students
